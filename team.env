# The ONE team settings file. Plain KEY=VALUE (bash syntax). Everything else reads it.
# If a ZeroTier IP changes: one person edits it here and pushes; everyone runs `git pull`
# and then `bd setup` again.

ZT_NETWORK_ID=

NODE1_IP=172.23.59.75
NODE2_IP=172.23.194.191
NODE3_IP=172.23.10.141
NODE4_IP=172.23.204.87

# ZeroTier MTU. Leave blank = do not touch it.
# If `bd netcheck` says the bulk transfer stalls, set 1400 here, then run `bd setup` on every node.
ZT_MTU=
